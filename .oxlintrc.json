{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "jsx-a11y", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off"
  },
  "overrides": [
    {
      "files": ["tests/setup-dom.ts"],
      "rules": { "import/no-unassigned-import": "off" }
    }
  ],
  "ignorePatterns": ["src/routeTree.gen.ts", "drizzle/**"]
}
