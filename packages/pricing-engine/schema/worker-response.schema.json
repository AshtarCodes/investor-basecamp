{
  "$defs": {
    "BatchResult": {
      "additionalProperties": false,
      "description": "One entry per contract of the request, in order.",
      "properties": {
        "contracts": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/PricedContract"
              },
              {
                "$ref": "#/$defs/FailedContract"
              }
            ]
          },
          "title": "Contracts",
          "type": "array"
        }
      },
      "required": [
        "contracts"
      ],
      "title": "BatchResult",
      "type": "object"
    },
    "CashDividend": {
      "additionalProperties": false,
      "description": "A cash dividend per share. It drops the spot at 09:30 America/New_York on `ex_date`.",
      "properties": {
        "amount": {
          "exclusiveMinimum": 0,
          "title": "Amount",
          "type": "number"
        },
        "ex_date": {
          "format": "date",
          "title": "Ex Date",
          "type": "string"
        },
        "from": {
          "minLength": 1,
          "title": "From",
          "type": "string"
        }
      },
      "required": [
        "ex_date",
        "amount",
        "from"
      ],
      "title": "CashDividend",
      "type": "object"
    },
    "CrossCheck": {
      "additionalProperties": false,
      "properties": {
        "difference": {
          "title": "Difference",
          "type": "number"
        },
        "model": {
          "const": "leisen_reimer",
          "title": "Model",
          "type": "string"
        },
        "price": {
          "title": "Price",
          "type": "number"
        },
        "steps": {
          "title": "Steps",
          "type": "integer"
        }
      },
      "required": [
        "model",
        "steps",
        "price",
        "difference"
      ],
      "title": "CrossCheck",
      "type": "object"
    },
    "FailedContract": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/WorkerError"
        },
        "ok": {
          "const": false,
          "default": false,
          "title": "Ok",
          "type": "boolean"
        }
      },
      "required": [
        "error"
      ],
      "title": "FailedContract",
      "type": "object"
    },
    "Failure": {
      "additionalProperties": false,
      "description": "`id` is null when the line had no readable id.",
      "properties": {
        "error": {
          "$ref": "#/$defs/WorkerError"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Id"
        },
        "ok": {
          "const": false,
          "default": false,
          "title": "Ok",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "error"
      ],
      "title": "Failure",
      "type": "object"
    },
    "Greeks": {
      "additionalProperties": false,
      "description": "Bump-and-reprice sensitivities: vega per vol point, theta per day, rho per rate point.",
      "properties": {
        "delta": {
          "title": "Delta",
          "type": "number"
        },
        "gamma": {
          "title": "Gamma",
          "type": "number"
        },
        "rho": {
          "title": "Rho",
          "type": "number"
        },
        "theta": {
          "title": "Theta",
          "type": "number"
        },
        "vega": {
          "title": "Vega",
          "type": "number"
        }
      },
      "required": [
        "delta",
        "gamma",
        "vega",
        "theta",
        "rho"
      ],
      "title": "Greeks",
      "type": "object"
    },
    "ImpliedVolatility": {
      "additionalProperties": false,
      "description": "The Mark-implied IV as a decimal, or why there is none.\n\n`residual` is the Mark minus the model value at the lowest \u03c3 bound; it is set only when\nthere is no IV, and ADR 0001 carries it unchanged under Shocks.",
      "properties": {
        "reason": {
          "anyOf": [
            {
              "enum": [
                "at_or_below_intrinsic",
                "no_bracket"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "residual": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Residual"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value"
      ],
      "title": "ImpliedVolatility",
      "type": "object"
    },
    "PriceResult": {
      "additionalProperties": false,
      "description": "A price and the inputs that produced it. `price` is null when there is no Mark-implied IV.",
      "properties": {
        "cross_check": {
          "anyOf": [
            {
              "$ref": "#/$defs/CrossCheck"
            },
            {
              "type": "null"
            }
          ]
        },
        "flags": {
          "items": {
            "enum": [
              "hard_to_borrow",
              "no_iv",
              "dividend_not_in_life",
              "expired"
            ],
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        },
        "greeks": {
          "anyOf": [
            {
              "$ref": "#/$defs/Greeks"
            },
            {
              "type": "null"
            }
          ]
        },
        "inputs": {
          "$ref": "#/$defs/PricedInputs"
        },
        "iv": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImpliedVolatility"
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "enum": [
            "black_scholes_merton",
            "black_76",
            "american_closed_form",
            "american_fd_cash_drop",
            "intrinsic"
          ],
          "title": "Model",
          "type": "string"
        },
        "price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Price"
        },
        "remaining_life_years": {
          "title": "Remaining Life Years",
          "type": "number"
        },
        "settlement_instant": {
          "format": "date-time",
          "title": "Settlement Instant",
          "type": "string"
        }
      },
      "required": [
        "price",
        "model",
        "inputs",
        "iv",
        "greeks",
        "cross_check",
        "settlement_instant",
        "remaining_life_years",
        "flags"
      ],
      "title": "PriceResult",
      "type": "object"
    },
    "PricedContract": {
      "additionalProperties": false,
      "description": "`prices[i]` is the per-share price under `shocks[i]`; `shock_flags` lists only flagged ones.\n\n`iv` is the Mark-implied IV. With none (`iv.value` is null), every Shock keeps the model's value\nat the lowest \u03c3 plus the residual, ignores the IV Shift, and `flags` includes `no_iv`.",
      "properties": {
        "flags": {
          "items": {
            "enum": [
              "hard_to_borrow",
              "no_iv",
              "dividend_not_in_life",
              "expired"
            ],
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        },
        "iv": {
          "$ref": "#/$defs/ImpliedVolatility"
        },
        "ok": {
          "const": true,
          "default": true,
          "title": "Ok",
          "type": "boolean"
        },
        "prices": {
          "items": {
            "type": "number"
          },
          "title": "Prices",
          "type": "array"
        },
        "shock_flags": {
          "items": {
            "$ref": "#/$defs/ShockFlags"
          },
          "title": "Shock Flags",
          "type": "array"
        }
      },
      "required": [
        "iv",
        "flags",
        "prices",
        "shock_flags"
      ],
      "title": "PricedContract",
      "type": "object"
    },
    "PricedInputs": {
      "additionalProperties": false,
      "description": "The request's inputs, echoed with their provenance. `volatility` is the \u03c3 priced at.",
      "properties": {
        "borrow_rate": {
          "$ref": "#/$defs/Sourced"
        },
        "continuous_yield": {
          "$ref": "#/$defs/Sourced"
        },
        "dividends": {
          "items": {
            "$ref": "#/$defs/CashDividend"
          },
          "title": "Dividends",
          "type": "array"
        },
        "forward": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sourced"
            },
            {
              "type": "null"
            }
          ]
        },
        "rate": {
          "$ref": "#/$defs/Sourced"
        },
        "spot": {
          "$ref": "#/$defs/Sourced"
        },
        "volatility": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sourced"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "spot",
        "rate",
        "volatility",
        "continuous_yield",
        "borrow_rate",
        "dividends",
        "forward"
      ],
      "title": "PricedInputs",
      "type": "object"
    },
    "Ready": {
      "additionalProperties": false,
      "description": "The first line on stdout, printed once the worker can price without further start-up cost.",
      "properties": {
        "pid": {
          "title": "Pid",
          "type": "integer"
        },
        "protocol": {
          "const": 1,
          "default": 1,
          "title": "Protocol",
          "type": "integer"
        },
        "type": {
          "const": "ready",
          "default": "ready",
          "title": "Type",
          "type": "string"
        },
        "workers": {
          "title": "Workers",
          "type": "integer"
        }
      },
      "required": [
        "pid",
        "workers"
      ],
      "title": "Ready",
      "type": "object"
    },
    "ShockFlags": {
      "additionalProperties": false,
      "description": "The flags on one Shock, by its index in the contract's `shocks`.",
      "properties": {
        "flags": {
          "items": {
            "enum": [
              "hard_to_borrow",
              "no_iv",
              "dividend_not_in_life",
              "expired"
            ],
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        },
        "shock": {
          "title": "Shock",
          "type": "integer"
        }
      },
      "required": [
        "shock",
        "flags"
      ],
      "title": "ShockFlags",
      "type": "object"
    },
    "Sourced": {
      "additionalProperties": false,
      "description": "A number and where it came from. Every input to a price names its source.",
      "properties": {
        "from": {
          "minLength": 1,
          "title": "From",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "from"
      ],
      "title": "Sourced",
      "type": "object"
    },
    "Success": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Id"
        },
        "ok": {
          "const": true,
          "default": true,
          "title": "Ok",
          "type": "boolean"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/PriceResult"
            },
            {
              "$ref": "#/$defs/BatchResult"
            }
          ],
          "title": "Result"
        }
      },
      "required": [
        "id",
        "result"
      ],
      "title": "Success",
      "type": "object"
    },
    "WorkerError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "invalid_json",
            "invalid_request",
            "unknown_type",
            "model_error",
            "internal"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "WorkerError",
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/Ready"
    },
    {
      "$ref": "#/$defs/Success"
    },
    {
      "$ref": "#/$defs/Failure"
    }
  ]
}
